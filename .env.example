# ── Firebase project config ────────────────────────────────────────────
# Get these from Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Who is allowed to sign in as admin ─────────────────────────────────
# Comma-separated list of Google account emails allowed to reach /admin.
# Everyone else who signs in with Google will be signed out automatically.
VITE_ADMIN_EMAILS=you@gmail.com

# ── The name that appears throughout the letter experience ────────────
VITE_RECIPIENT_NAME=Jessa Mae
VITE_RECIPIENT_FULL_NAME=Jessa Mae Almiano Alfeche
VITE_SENDER_NAME=Your Name
