rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Keep this list identical to VITE_ADMIN_EMAILS in your .env ──────
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'occ.antiquina.joneejohn@gmail.com'
        ];
    }

    // Questions & letters are written only by the admin, but anyone
    // holding the link can read them (that's the whole point — Jessa
    // never signs in, she just opens the letter).
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /letters/{letterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public site copy (hero title, intro line, seal color, etc.)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anyone with the link can create ONE response record of her own
    // (her answers + which letters she opened). She can never read,
    // list, edit, or delete responses — only the admin can.
    match /responses/{responseId} {
      allow create: if true;
      allow update: if request.auth == null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answers', 'openedLetterIds', 'finalDecision', 'respondedAt', 'updatedAt']);
      allow read, list, delete: if isAdmin();
    }
  }
}
